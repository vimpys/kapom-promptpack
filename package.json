{
  "name": "kapom-promptpack",
  "displayName": "Kapom PromptPack",
  "description": "แพ็คไฟล์ในโปรเจกต์เป็น prompt เดียว สำหรับ AiPASS, ChatGPT, Claude และ AI แชทอื่นๆ",
  "version": "0.0.1",
  "publisher": "kapom-soft",
  "author": "Kapom (https://github.com/vimpys)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vimpys/kapom-promptpack.git"
  },
  "bugs": {
    "url": "https://github.com/vimpys/kapom-promptpack/issues"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "aipass",
    "th-ai-passport",
    "thai",
    "context",
    "prompt",
    "clipboard",
    "llm"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kapomPromptPack.hello",
        "title": "Hello",
        "category": "Kapom PromptPack"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "vsix": "vsce package",
    "compile-tests": "tsc -p .",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0"
  }
}
